# ── Virtual environment ────────────────────────────────────────────
mpenv/
venv/
env/
.venv/

# ── Python cache / build ───────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg

# ── Raw / heavy data (regenerable from "Zipped data" + scripts) ─────
# recording/: 157 test/session folders, very heavy
recording/
# prepared_dataset/: ~368 MB, mostly video — but keep the hand-edited metadata.csv
prepared_dataset/*
!prepared_dataset/metadata.csv

# ── Media & generated review artifacts (regenerated by dataprocessing.py) ─
*.mp4
*.avi
motion_report.html
graphs_only.html
Open_Viewer.bat

# ── Trained model binary (regenerable in seconds; JSON summaries are kept) ─
models/*.joblib

# NOTE: analysis CSVs (features.csv, results*.csv, feature_importance.csv) are
# deliberately NOT ignored — small and useful to read on clone. The heavy
# per-session CSVs live under recording/ and prepared_dataset/, ignored above.

# ── IDE / OS junk ──────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Secrets ────────────────────────────────────────────────────────
.env
.env.local
